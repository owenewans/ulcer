ULCER_HTTP_ADDR=127.0.0.1:8080
ULCER_GRPC_ADDR=127.0.0.1:8443
ULCER_DATA_DIR=./data/host
ULCER_PUBLIC_NAME=localhost
# Set only for deterministic unattended bootstrap. Otherwise the token is
# generated at ULCER_DATA_DIR/setup.token with mode 0600 and printed once.
ULCER_SETUP_TOKEN=

# UI development proxy.
ULCER_API_ORIGIN=http://127.0.0.1:8080

FROM docker.io/library/golang@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api ./api
COPY cmd ./cmd
COPY gen ./gen
COPY internal ./internal
COPY versions ./versions
ARG TARGETOS=linux
ARG TARGETARCH
ARG BUILD_VERSION=development
ARG BUILD_REVISION=unknown
ARG BUILD_SOURCE_REF=unknown
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath \
    -ldflags="-s -w -X github.com/owenewans/ulcer/internal/buildinfo.Version=${BUILD_VERSION} -X github.com/owenewans/ulcer/internal/buildinfo.Revision=${BUILD_REVISION} -X github.com/owenewans/ulcer/internal/buildinfo.SourceRef=${BUILD_SOURCE_REF}" \
    -o /out/ulcer-host ./cmd/ulcer-host

FROM docker.io/library/debian@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ulcer-host /usr/local/bin/ulcer-host
RUN mkdir -p /var/lib/ulcer && chown 65532:65532 /var/lib/ulcer
USER 65532:65532
ENV ULCER_HTTP_ADDR=0.0.0.0:8080 \
    ULCER_GRPC_ADDR=0.0.0.0:8443 \
    ULCER_DATA_DIR=/var/lib/ulcer
VOLUME ["/var/lib/ulcer"]
EXPOSE 8080 8443
ENTRYPOINT ["/usr/local/bin/ulcer-host"]

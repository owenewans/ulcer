FROM docker.io/oven/bun@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f AS build

WORKDIR /src
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build

FROM docker.io/oven/bun@sha256:9dba1a1b43ce28c9d7931bfc4eb00feb63b0114720a0277a8f939ae4dfc9db6f

WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=build --chown=bun:bun /src/.next/standalone ./
COPY --from=build --chown=bun:bun /src/.next/static ./.next/static
COPY --from=build --chown=bun:bun /src/public ./public
USER bun
EXPOSE 3000
CMD ["bun", "server.js"]
